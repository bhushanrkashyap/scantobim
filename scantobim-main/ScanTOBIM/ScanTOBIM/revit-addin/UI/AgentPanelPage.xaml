<!--
  AgentPanelPage.xaml
  ScanToBIM Agent dockable panel — WPF Page (PoV)
  Registers as a dockable pane on the right side of Revit.
-->
<Page x:Class="ScanToBIM.UI.AgentPanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#06080e" UseLayoutRounding="True">

  <Page.Resources>

    <!-- Typography -->
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Courier New"/>
      <Setter Property="FontSize"   Value="11"/>
      <Setter Property="Foreground" Value="#b0c4e0"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontFamily"   Value="Segoe UI"/>
      <Setter Property="FontSize"     Value="9"/>
      <Setter Property="FontWeight"   Value="SemiBold"/>
      <Setter Property="Foreground"   Value="#4a5e78"/>
        </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background"       Value="#0c0f18"/>
      <Setter Property="BorderBrush"      Value="#182030"/>
      <Setter Property="BorderThickness"  Value="1"/>
      <Setter Property="CornerRadius"     Value="3"/>
      <Setter Property="Padding"          Value="10 8"/>
      <Setter Property="Margin"           Value="0 0 0 4"/>
    </Style>

    <!-- Button -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background"      Value="#0c0f18"/>
      <Setter Property="BorderBrush"     Value="#263050"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"      Value="#b0c4e0"/>
      <Setter Property="FontFamily"      Value="Consolas"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Padding"         Value="12 5"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#10141f"/>
                <Setter Property="BorderBrush" Value="#4a5e78"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#182030"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- DataGrid style -->
    <Style TargetType="DataGrid">
      <Setter Property="Background"            Value="Transparent"/>
      <Setter Property="BorderThickness"        Value="0"/>
      <Setter Property="GridLinesVisibility"    Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#182030"/>
      <Setter Property="RowBackground"          Value="Transparent"/>
      <Setter Property="AlternatingRowBackground" Value="#0a0d14"/>
      <Setter Property="Foreground"             Value="#b0c4e0"/>
      <Setter Property="FontFamily"             Value="Consolas"/>
      <Setter Property="FontSize"               Value="10.5"/>
      <Setter Property="HeadersVisibility"      Value="Column"/>
      <Setter Property="SelectionMode"          Value="Single"/>
      <Setter Property="AutoGenerateColumns"    Value="False"/>
      <Setter Property="CanUserResizeRows"       Value="False"/>
      <Setter Property="IsReadOnly"             Value="True"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background"   Value="#10141f"/>
      <Setter Property="Foreground"   Value="#4a5e78"/>
      <Setter Property="FontFamily"   Value="Segoe UI"/>
      <Setter Property="FontSize"     Value="9"/>
      <Setter Property="FontWeight"   Value="SemiBold"/>
      <Setter Property="Padding"      Value="8 4"/>
      <Setter Property="BorderBrush"  Value="#182030"/>
      <Setter Property="BorderThickness" Value="0 0 0 1"/>
    </Style>

  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="10 10 10 20">

      <!-- ── HEADER ─────────────────────────────────────────────────────── -->
      <Border Style="{StaticResource Card}" BorderBrush="#263050" Margin="0 0 0 6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="SCAN-TO-BIM AGENT"
                       FontFamily="Segoe UI" FontWeight="Bold" FontSize="12"
                       Foreground="#e0eaff"/>
            <TextBlock Text="Proof of Value · Revit Bridge · port 8766"
                       Style="{StaticResource Mono}" Foreground="#4a5e78"
                       FontSize="10" Margin="0 2 0 0"/>
          </StackPanel>

          <TextBlock Grid.Column="1"
                     Text="{Binding StatusText}"
                     FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                     Foreground="{Binding StatusColor}"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- ── STATS ──────────────────────────────────────────────────────── -->
      <UniformGrid Columns="3" Margin="0 0 0 4">

        <Border Style="{StaticResource Card}" Margin="0 0 2 0">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{Binding ElementsCreated}"
                       FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                       Foreground="#00c896" HorizontalAlignment="Center"/>
            <TextBlock Text="CREATED" Style="{StaticResource Label}"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="2 0 2 0">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{Binding ElementsBlocked}"
                       FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                       Foreground="#e84040" HorizontalAlignment="Center"/>
            <TextBlock Text="BLOCKED" Style="{StaticResource Label}"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="2 0 0 0">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{Binding QueueDepth}"
                       FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                       Foreground="#f5a623" HorizontalAlignment="Center"/>
            <TextBlock Text="QUEUED" Style="{StaticResource Label}"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

      </UniformGrid>

      <!-- ── CONTROLS ───────────────────────────────────────────────────── -->
      <StackPanel Orientation="Horizontal" Margin="0 4 0 8">
        <Button Content="{Binding ToggleLabel}"
                Command="{Binding ToggleBridgeCommand}"
                Style="{StaticResource Btn}" Margin="0 0 4 0"/>
        <Button Content="Clear"
                Command="{Binding ClearCommand}"
                Style="{StaticResource Btn}"/>
      </StackPanel>

      <!-- ── RESULTS TABLE ──────────────────────────────────────────────── -->
      <TextBlock Text="ELEMENT RESULTS" Style="{StaticResource Label}"
                 Margin="0 0 0 4"/>
      <Border Style="{StaticResource Card}" MaxHeight="160">
        <DataGrid ItemsSource="{Binding Results}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="TIME"    Width="60"  Binding="{Binding Time}"/>
            <DataGridTextColumn Header="INSTR"   Width="70"  Binding="{Binding InstructionId}"/>
            <DataGridTextColumn Header="REVIT ID" Width="90" Binding="{Binding ElementId}"/>
            <DataGridTemplateColumn Header="STATUS" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Status}"
                             Foreground="{Binding StatusColor}"
                             FontFamily="Consolas" FontSize="10.5"
                             VerticalAlignment="Center" Margin="4 0"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="ms"     Width="44"  Binding="{Binding DurationMs}"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- ── LOG ───────────────────────────────────────────────────────── -->
      <TextBlock Text="LOG" Style="{StaticResource Label}" Margin="0 8 0 4"/>
      <Border Style="{StaticResource Card}" MaxHeight="300">
        <ListBox ItemsSource="{Binding Logs}"
                 Background="Transparent" BorderThickness="0"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                         Foreground="#506070" TextWrapping="Wrap"
                         Margin="0 1"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Padding"    Value="0"/>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
